# use Railway's DATABASE_PUBLIC_URL here, not DATABASE_URL
# DATABASE_URL only resolves inside Railway's private network, wont work from your machine
# DATABASE_PUBLIC_URL is the one routed through Railway's public proxy
#
# keep sslmode=require, Railway's public proxy expects TLS unlike the local plaintext container
DATABASE_URL=postgres://user:password@some-proxy.rlwy.net:12345/railway?sslmode=require

# dbmate paths kept here so scripts are minimal
DBMATE_MIGRATIONS_DIR=server/src/db/migrations
DBMATE_SCHEMA_FILE=server/src/db/schema.sql
