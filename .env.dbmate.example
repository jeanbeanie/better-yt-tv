# For dbmate running inside Docker, talk to Postgres via the compose service name:
DATABASE_URL=postgres://postgres:postgres@db:5432/better_yt_tv?sslmode=disable

# dbmate paths kept here so scripts are minimal
DBMATE_MIGRATIONS_DIR=server/src/db/migrations
DBMATE_SCHEMA_FILE=server/src/db/schema.sql

# Credentials for the docker-compose Postgres container itself -- must match
# the user/password/db name embedded in DATABASE_URL above
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=better_yt_tv
