# ======================
# Server
# ======================
PORT=5179

# Postgres (used by server only)
# Example for local dev:
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/better_yt_tv?sslmode=disable

# Used to encrypt refresh tokens at rest in Postgres (server-only)
# Use a long random value in your real .env (32+ chars recommended)
TOKEN_ENCRYPTION_KEY=change-me-please-use-a-long-random-string

# ======================
# Google / YouTube OAuth (server-only secrets except CLIENT_ID)
# ======================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must exactly match what you configure in Google Cloud Console OAuth settings
OAUTH_CALLBACK_URL=http://localhost:5179/api/auth/callback

# ======================
# App behavior
# ======================
YOUTUBE_CACHE_TTL_MINUTES=240

# Where the client runs in dev (useful for CORS later if needed)
CLIENT_ORIGIN=http://localhost:5173

# ======================
# Stripe
# ======================
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
